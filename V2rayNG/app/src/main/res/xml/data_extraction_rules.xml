<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replacement for allowBackup. Both transports are refused outright rather than
  filtered: there is nothing in this app's storage that is safe to copy off the device
  without the user asking, and an allow-list would be one forgotten entry away from leaking
  the server list.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
