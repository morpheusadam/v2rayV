# Rules for the CDN document root.
#
# This directory sits inside a WordPress install and is reachable two ways — as the document
# root of cdn.bineret.com, and as /cdn/ under the main site. The rules below exist so that
# both behave the same and so that a public static directory inside a PHP application cannot
# become a way to run PHP.

# WordPress rewrites every request that is not an existing file into index.php. Files here do
# exist, so the rewrite never fires for them — but a request for something missing would be
# answered with WordPress's 404 page rather than a plain one, and a client fetching a
# subscription list would receive several kilobytes of HTML instead of a 404 it can act on.
RewriteEngine Off

# Nothing here is meant to be executed. The files are lists and JSON, written by cron; if a
# PHP file ever appears in this tree it arrived by accident or by attack, and either way it
# should be served as nothing at all.
<FilesMatch "\.(?i:php|phtml|phps|php[0-9]|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# No directory listing. index.html is generated by the sync run and lists what is actually
# published, which is the same information without exposing temporary files mid-write.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
    # These lists are public by design and are fetched by apps, by browsers and by other
    # people's tooling. Denying cross-origin reads would only break the honest callers.
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"

    # Cron refreshes every 30 minutes, so five minutes of caching costs a little freshness and
    # saves the origin most of the load. stale-while-revalidate lets an intermediary keep
    # answering from cache while it refetches, which is what should happen when the origin is
    # the thing having a bad day.
    <FilesMatch "\.(?i:txt|json)$">
        Header set Cache-Control "public, max-age=300, stale-while-revalidate=600"
    </FilesMatch>

    # The freshness report is the file somebody reads when they suspect the mirror is stale.
    # Serving them a cached copy of it would answer the wrong question.
    <Files "status.json">
        Header set Cache-Control "public, max-age=30"
    </Files>

    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Subscription lists are base64 and URLs; without an explicit charset a browser guesses, and
# a remark containing a flag emoji or Persian text comes out as mojibake.
AddDefaultCharset UTF-8
AddType text/plain;charset=UTF-8 .txt
AddType application/json;charset=UTF-8 .json

# A partially written file is never renamed into place, but if a run is killed between the
# write and the rename one can be left behind. It should never be served.
<FilesMatch "\.tmp\.[0-9]+$">
    Require all denied
</FilesMatch>
